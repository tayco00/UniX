{
  "name": "unix-student-os",
  "productName": "UniX",
  "version": "0.3.0",
  "description": "UniX",
  "author": "UniX",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons": "node scripts/build-icon.mjs",
    "dev": "concurrently --kill-others --names WEB,DESKTOP --prefix-colors blue,magenta \"npm:dev:web\" \"npm:dev:desktop\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:desktop": "wait-on http-get://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "start": "npm run dev",
    "stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop.ps1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:packaged": "node scripts/desktop-smoke.mjs --packaged",
    "quality:criteria": "node scripts/check-criteria.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test:run && npm run quality:criteria",
    "build:web": "vite build",
    "pack": "npm run quality && npm run build:web && electron-builder --dir --win --x64",
    "build": "npm run quality && npm run build:web && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "lucide-react": "1.44.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "17.12.0",
    "jsdom": "29.0.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "de.unix.studentos",
    "productName": "UniX",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "UniX-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniX"
    }
  }
}
