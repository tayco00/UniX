{
  "name": "unix-desktop-host",
  "productName": "UniX",
  "version": "0.5.0",
  "description": "UniX",
  "author": "Taylan",
  "private": true,
  "repository": "https://github.com/tayco00/UniX",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "flutter": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/flutter.ps1",
    "dart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dart.ps1",
    "format:check": "npm run dart -- format --output=none --set-exit-if-changed lib test",
    "analyze": "npm run flutter -- analyze",
    "test:dart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test.ps1",
    "test:host": "node --test desktop/*.test.cjs",
    "test:product": "node scripts/check-product.cjs",
    "audit": "npm audit --audit-level=high",
    "criteria": "node scripts/check-criteria.cjs",
    "quality": "npm run format:check && npm run analyze && npm run test:dart && npm run test:host && npm run test:product && npm run criteria",
    "dev:web": "npm run flutter -- run -d web-server --web-hostname 127.0.0.1 --web-port 5173",
    "dev:host": "wait-on http-get://127.0.0.1:5173 && cross-env UNIX_DEV_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently --kill-others --names FLUTTER,DESKTOP \"npm:dev:web\" \"npm:dev:host\"",
    "build:flutter": "npm run flutter -- build web --release --no-web-resources-cdn --no-wasm-dry-run",
    "test:desktop": "node scripts/desktop-smoke.cjs",
    "test:packaged": "node scripts/desktop-smoke.cjs --packaged",
    "icons": "node scripts/build-icon.cjs",
    "pack": "npm run quality && npm run build:flutter && electron-builder --dir --win --x64",
    "build": "npm run quality && npm run build:flutter && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.3.0",
    "electron-builder": "26.15.3",
    "sharp": "0.35.4",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "app.unix.desktop",
    "productName": "UniX",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/web/**/*",
      "desktop/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/brand/unix.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "UniX-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "UniX"
    }
  }
}
